PIPELENS_ENVIRONMENT=development
PIPELENS_WEBHOOK_SECRET=replace-me
PIPELENS_GITHUB_APP_ID=
PIPELENS_GITHUB_PRIVATE_KEY=
PIPELENS_GITHUB_APP_SLUG=
PIPELENS_GITHUB_CLIENT_ID=
PIPELENS_GITHUB_CLIENT_SECRET=
PIPELENS_PUBLIC_URL=http://localhost:3000
PIPELENS_AUTH_REQUIRED=true
PIPELENS_SESSION_SECRET=replace-with-a-long-random-value
PIPELENS_TOKEN_ENCRYPTION_KEY=
PIPELENS_TOKEN_ENCRYPTION_FALLBACK_KEYS=
PIPELENS_SESSION_COOKIE_SECURE=false
PIPELENS_DATABASE_PATH=./pipelens.db
PIPELENS_DATABASE_URL=
PIPELENS_PUBLISH_CHECKS=false
PIPELENS_LOG_CHUNK_CHARS=200000
PIPELENS_MAX_ERROR_CHUNKS=10
PIPELENS_LLM_PROVIDER=none
PIPELENS_OPENAI_API_KEY=
PIPELENS_OPENAI_MODEL=gpt-5.6
PIPELENS_LLM_INPUT_COST_PER_MILLION=0
PIPELENS_LLM_OUTPUT_COST_PER_MILLION=0
PIPELENS_QUEUE_BACKEND=memory
PIPELENS_REDIS_URL=redis://localhost:6379/0
PIPELENS_WORKER_MAX_ATTEMPTS=3
PIPELENS_WORKER_METRICS_PORT=8001
PIPELENS_WORKER_LEASE_SECONDS=60
PIPELENS_WORKER_HEARTBEAT_SECONDS=15
PIPELENS_HTTP_RETRY_MAX_ATTEMPTS=3
PIPELENS_HTTP_RETRY_BASE_SECONDS=1
PIPELENS_HTTP_RETRY_MAX_SECONDS=60
PIPELENS_ANALYSIS_START_SLO_SECONDS=60
PIPELENS_ANALYSIS_COMPLETION_SLO_SECONDS=120
